# Development only. Run: python scripts/init_env.py
# Creates .env with random local secrets. Never commit .env.
APP_ENV=development
HTTP_PORT=8080
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=["http://localhost:8080"]
ALLOWED_HOSTS=["localhost","127.0.0.1","backend","testserver"]
LIBRARY_TIMEZONE=Asia/Qyzylorda
LOG_LEVEL=INFO
POSTGRES_DB=smartlibrary
POSTGRES_USER=smartlibrary
POSTGRES_PASSWORD=
# PostgreSQL bootstrap owner above is used only by postgres and operator tools.
APP_DB_USER=smartlibrary_app
APP_DB_PASSWORD=
MIGRATION_DB_USER=smartlibrary_migrator
MIGRATION_DB_PASSWORD=
# Development-only account password; seed refuses production and never prints it.
DEV_SEED_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional runtime DSN override: use the restricted application role, never the owner.
DATABASE_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
JWT_SECRET=
QR_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Fixed-window auth limits: login per IP/account per 900s; register/IP/hour;
# refresh/IP/minute. Compose trusts only its private, header-overwriting Nginx ingress.
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_LIMIT=10
AUTH_REFRESH_LIMIT=120
TRUST_PROXY_HEADERS=false
UPLOAD_DIRECTORY=/app/var/uploads
MODEL_CACHE_DIRECTORY=/app/var/models
# Set a private GroqCloud key to enable the assistant. Default model: openai/gpt-oss-120b.
GROQ_API_KEY=
# Optional overrides. For OpenAI set LLM_PROVIDER=openai, LLM_MODEL and LLM_API_KEY.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# PHASE 12 validation-selected model; run the documented download/init command.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_MODEL_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
# Production has an independent .env.production, created by init_production_env.py.
# Its additional PUBLIC_HOST/PUBLIC_ORIGIN/HTTPS_PORT/DEPLOY_BIND_ADDRESS/TLS_DIRECTORY
# values are documented in docs/PRODUCTION_DEPLOYMENT.md; never reuse dev credentials.
